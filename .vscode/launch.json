{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS 2: 当前 Python 文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "ROS_DOMAIN_ID": "0"
      },
      "justMyCode": true
    },
    {
      "name": "pytest: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
